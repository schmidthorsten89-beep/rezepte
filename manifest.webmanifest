{
  "name": "Meine Rezepte",
  "short_name": "Rezepte",
  "description": "Rezepte per Link speichern, Portionen umrechnen und Einkaufsliste führen",
  "lang": "de",
  "id": "/rezepte/?app=io.github.schmidthorsten89-beep.rezepte",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#3a7d3a",
  "theme_color": "#3a7d3a",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
